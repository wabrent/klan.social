# --- Klan (klan.social) environment ----------------------------------
# Copy to .env.local and fill in.

# Public URL of the site (used for the X OAuth callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to HMAC-sign session cookies. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# X (Twitter) OAuth 2.0 app credentials — https://developer.x.com
# Callback URL to register in the app: {NEXT_PUBLIC_SITE_URL}/api/auth/x/callback
# Without these the app runs in demo mode (demo personas on /signin).
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# --- Robinhood Chain ---------------------------------------------------
# Какую сеть использовать: mainnet (chain ID 4663) или testnet (46630).
# Газ — в ETH. Публичный RPC подставляется из src/lib/chain.ts.
NEXT_PUBLIC_RH_NETWORK=mainnet

# Адрес задеплоенного контракта KlanOath (см. contracts/KlanOath.sol).
# Пусто — кнопка «Поклясться ончейн» скрыта, вход кошельком работает.
NEXT_PUBLIC_OATH_CONTRACT=
